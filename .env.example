# Application configuration (required for app-dependent tests)
BASE_URL=
API_URL=
TEST_ID_ATTRIBUTE=data-testid
PW_SLOW_MO=0

# Authentication is project-specific. Keep credentials and tokens in a secret
# manager or an ignored local .env file; do not add them to this template.
# AUTH_MODE=
# STORAGE_STATE=

# Optional Xray reporting. Leave blank unless the project has configured Xray.
JIRA_URL=
XRAY_URL=
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=
XRAY_TEST_PLAN=
XRAY_DEBUG=false
