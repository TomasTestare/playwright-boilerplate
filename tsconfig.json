{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node", "@playwright/test"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report", "pageObjects/pageFixture.ts", "pageObjects/gvrPageFixture.ts", "utils/testDataConfig.ts", "utils/testData.ts", "utils/selectors.ts"]
}
